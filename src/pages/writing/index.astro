---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Nav from '../../components/Nav.astro';
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/site';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    dateStyle: 'long',
    timeZone: 'UTC',
  }).format(date);
---

<Base
  title={`Systems and Embedded Software Notes | ${profile.name}`}
  description={`First-hand engineering case studies by ${profile.name} on embedded systems, C++ concurrency, React Native iOS apps, application security, and private on-device software.`}
>
  <Nav />
  <main id="main-content" class="writing-index" tabindex="-1">
    <div class="container">
      <p class="eyebrow">03 / Notes</p>
      <h1>Notes from the underground</h1>
      <p class="writing-index__intro">
        First-hand engineering case studies about C++ systems, embedded
        software, React Native iOS applications, application security, and the
        tradeoffs behind dependable products.
      </p>

      <ol class="writing-index__list">
        {posts.map((post) => (
          <li>
            <article class="writing-card">
              <p class="eyebrow">{formatDate(post.data.publishedDate)}</p>
              <h2>
                <a href={`/writing/${post.slug}/`}>{post.data.title}</a>
              </h2>
              <p class="muted">{post.data.description}</p>
              <ul class="chips" aria-label="Topics">
                {post.data.tags.map((tag) => <li class="chip">{tag}</li>)}
              </ul>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .writing-index {
    min-height: 70vh;
    padding: clamp(3rem, 8vw, 7rem) 0;
  }

  .writing-index h1 {
    max-width: 11ch;
    margin-top: 1rem;
    font: 900 clamp(3rem, 11vw, 9rem)/0.82 var(--font-display);
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .writing-index__intro {
    max-width: 48ch;
    margin-top: 1.5rem;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .writing-index__list {
    margin-top: 3rem;
    padding: 0;
    display: grid;
    gap: 1rem;
    list-style: none;
  }

  .writing-card {
    padding: 1.5rem;
    border: var(--rule);
    background: var(--white);
  }

  .writing-card:hover {
    background: var(--green);
  }

  .writing-card h2 {
    margin-block: 0.75rem;
    font-size: clamp(1.8rem, 4vw, 3.5rem);
  }

  @media (max-width: 639px) {
    .writing-index h1 {
      font-size: clamp(2rem, 10.5vw, 4rem);
    }
  }
</style>
