---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { education, experience, featuredSkills, links, profile, projects } from '../data/site';
import { biographyGraph } from '../data/seo';
---

<Base
  title={`${profile.name} | ${profile.title}`}
  description={profile.biography}
  structuredData={biographyGraph}
  motion={false}
>
  <Nav motion={false} />
  <main id="main-content" class="about container" tabindex="-1">
    <header class="about__intro">
      <p class="eyebrow">About / engineering profile</p>
      <h1>Nathaniel Mapaye</h1>
      <p>{profile.biography}</p>
      <p>Full name: {profile.fullName}. My work also includes application security, Kubernetes, and AI evaluation.</p>
      <p class="about__contact">
        <a href={`mailto:${links.email}`}>{links.email}</a> · <a href={links.github}>GitHub</a> · <a href={links.linkedin}>LinkedIn</a>
      </p>
    </header>

    <section aria-labelledby="about-skills">
      <h2 id="about-skills">Technical focus</h2>
      <ul class="chips" aria-label="Technical skills">
        {featuredSkills.map((skill) => <li class="chip">{skill}</li>)}
      </ul>
    </section>

    <section aria-labelledby="about-projects">
      <h2 id="about-projects">Selected projects</h2>
      <div class="about__projects">
        {projects.map((project) => (
          <article>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <dl>
              <div><dt>Problem</dt><dd>{project.focus.problem}</dd></div>
              <div><dt>System design</dt><dd>{project.focus.systemDesign}</dd></div>
              <div><dt>Evidence</dt><dd>{project.focus.evidence}</dd></div>
              <div><dt>Outcome</dt><dd>{project.focus.outcome}</dd></div>
            </dl>
            {project.links && <p>{project.links.map((link) => <a href={link.href}>{link.label}</a>)}</p>}
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="about-experience">
      <h2 id="about-experience">Experience</h2>
      <ol class="about__experience">
        {experience.map((item) => (
          <li>
            <h3>{item.role}, {item.org}</h3>
            <p>{item.period}{item.location && ` · ${item.location}`}</p>
            <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="about-education">
      <h2 id="about-education">Education</h2>
      <p>{education[0].degree}, {education[0].school}, {education[0].period}</p>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .about { max-width: 920px; padding-block: clamp(3rem, 8vw, 7rem); }
  .about section { margin-top: clamp(3rem, 7vw, 5rem); }
  .about h1 { max-width: 11ch; margin-top: 1rem; font: 900 clamp(3rem, 10vw, 7rem)/0.85 var(--font-display); letter-spacing: -0.05em; text-transform: uppercase; }
  .about h2 { margin-bottom: 1rem; font: 900 clamp(1.8rem, 4vw, 3rem)/0.9 var(--font-display); letter-spacing: -0.035em; text-transform: uppercase; }
  .about h3 { font: 900 1.25rem/1 var(--font-display); letter-spacing: -0.02em; text-transform: uppercase; }
  .about__intro > p:not(.eyebrow) { max-width: 62ch; margin-top: 1.5rem; font-size: 1.15rem; font-weight: 700; }
  .about__contact { font-family: var(--font-mono); font-size: 0.85rem; }
  .about__projects { display: grid; gap: 1rem; }
  .about__projects article, .about__experience li { padding: 1.25rem; border: var(--rule); background: var(--white); }
  .about__projects article > p { margin-top: 0.75rem; }
  .about__projects dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1rem; border-top: 2px solid var(--ink); border-left: 2px solid var(--ink); }
  .about__projects dl > div { padding: 0.75rem; border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .about__projects dt { font: 900 0.65rem/1.2 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .about__projects dd { margin-top: 0.35rem; font-size: 0.88rem; line-height: 1.35; }
  .about__projects article a + a::before { content: ' · '; }
  .about__experience { display: grid; gap: 1rem; padding: 0; list-style: none; }
  .about__experience li p { margin-top: 0.35rem; font: 800 0.75rem/1.3 var(--font-mono); }
  .about__experience ul { margin-top: 0.8rem; }
  .about__experience li li + li { margin-top: 0.5rem; }
  @media (max-width: 639px) { .about__projects dl { grid-template-columns: 1fr; } }
</style>
