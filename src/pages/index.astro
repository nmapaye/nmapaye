---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import OperatingRange from '../components/OperatingRange.astro';
import ChapterIndex from '../components/ChapterIndex.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import Notes from '../components/Notes.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { identityGraph } from '../data/seo';
import { profile } from '../data/site';

const title = `${profile.name} | Bay Area Systems & Embedded Software Engineer`;
const description = profile.description;
---

<Base title={title} description={description} structuredData={identityGraph} kinetic>
  <Nav />
  <main id="main-content" tabindex="-1">
    <Hero />
    <OperatingRange />
    <ChapterIndex />
    <Projects />
    <Experience />
    <Notes />
    <Contact />
  </main>
  <Footer />
</Base>
