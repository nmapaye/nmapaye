---
import { links, profile } from '../data/site';
const base = import.meta.env.BASE_URL;
const resume = `${base}/${profile.resume}`.replace(/\/+/g, '/');
---

<section id="contact" class="section contact">
  <div class="container">
    <h2 class="section__title">Contact</h2>
    <p class="contact__lead">
      Open to internships and new-grad roles in systems, embedded, and full-stack
      engineering. The fastest way to reach me is email.
    </p>

    <div class="contact__links">
      <a class="btn btn--primary" href={`mailto:${links.email}`}>{links.email}</a>
      <a class="btn" href={`tel:${links.phone.replace(/[^+\d]/g, '')}`}>{links.phone}</a>
      <a class="btn" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn" href={links.github} target="_blank" rel="noopener">GitHub</a>
      <a class="btn" href={resume} target="_blank" rel="noopener">Resume (PDF)</a>
    </div>
  </div>
</section>

<style>
  .contact__lead {
    max-width: 52ch;
    font-size: var(--fs-lg);
    color: var(--muted);
    margin-bottom: var(--sp-8);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
</style>
