---
import type { Project } from '../data/site';
import CardStack from './effects/CardStack.astro';
import GlitchText from './effects/GlitchText.astro';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="project-card" data-motion-card={project.index}>
  <CardStack project={project} />
  <header>
    <span>{project.index}</span>
    {project.period && <time>{project.period}</time>}
  </header>
  <div class="glitch-text" data-motion-shuffle data-motion-shuffle-label={project.name}>
    <h3>{project.name}</h3>
    <GlitchText text={project.name} />
  </div>
  <p class="project-card__tagline">{project.tagline}</p>
  <p>{project.description}</p>
  <dl class="project-card__focus">
    <div><dt>Problem</dt><dd>{project.focus.problem}</dd></div>
    <div><dt>System design</dt><dd>{project.focus.systemDesign}</dd></div>
    <div><dt>Evidence</dt><dd>{project.focus.evidence}</dd></div>
    <div><dt>Outcome</dt><dd>{project.focus.outcome}</dd></div>
  </dl>
  <ul class="project-card__stack" aria-label={`${project.name} technologies`}>
    {project.stack.map((tech) => <li>{tech}</li>)}
  </ul>
  {project.links && (
    <div class="project-card__links">
      {project.links.map((link) => (
        <a data-motion-burst data-motion-shake-related="work-title" href={link.href} rel={link.href.startsWith('http') ? 'noopener' : undefined}>
          {link.label} ↗
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .project-card {
    min-height: 100%;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-right: var(--rule);
    border-bottom: var(--rule);
    background: var(--white);
  }

  .project-card header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font: 900 0.7rem/1.2 var(--font-mono);
    text-transform: uppercase;
  }

  .project-card .glitch-text {
    font: 900 clamp(2.7rem, 5vw, 4.5rem)/0.85 var(--font-display);
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .project-card__tagline {
    font-weight: 900;
    text-transform: uppercase;
  }

  .project-card__focus {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .project-card__focus div { display: grid; gap: 0.2rem; }
  .project-card__focus dt {
    font: 900 0.62rem/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .project-card__focus dd { font-size: 0.86rem; line-height: 1.35; }

  .project-card__stack {
    margin-top: auto;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .project-card__stack li {
    padding: 0.35rem 0.5rem;
    border: 2px solid var(--ink);
    font: 800 0.68rem/1 var(--font-mono);
    text-transform: uppercase;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
  }

  .project-card__links a {
    min-height: 44px;
    padding: 0.75rem;
    display: grid;
    place-items: center;
    border: 2px solid var(--ink);
    color: var(--ink);
    font-weight: 900;
    text-transform: uppercase;
  }

  .project-card__links a:hover {
    background: var(--red);
    text-decoration: none;
  }
</style>
