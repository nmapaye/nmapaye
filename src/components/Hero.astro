---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/portfolio/hero-balloon.png';
import KineticMarquee from './effects/KineticMarquee.astro';
import { links, profile } from '../data/site';

const base = import.meta.env.BASE_URL;
const resume = `${base}/${profile.resume}`.replace(/\/+/g, '/');
---

<section id="top" class="cover" data-motion-hero aria-labelledby="cover-title">
  <div class="cover__issue" aria-hidden="true">NATHANIEL MAPAYE / ISSUE 01</div>
  <Image
    class="cover__photo"
    src={heroPhoto}
    alt="Nathaniel Mapaye inside an immersive balloon installation"
    widths={[480, 720, 960, 1280, 1600]}
    sizes="(max-width: 639px) 100vw, 66vw"
    format="webp"
    quality={82}
    loading="eager"
    fetchpriority="high"
  />
  <div class="cover__content">
    <p class="chapter__label">Systems Engineer · C++23 · FreeRTOS · Go</p>
    <h1 id="cover-title" class="display" data-motion-shake>Systems<br />to screens.</h1>
    <p>{profile.tagline}</p>
    <div class="cover__actions">
      <a class="btn btn--primary" data-motion-burst data-motion-shake-related="cover-title" href="#work">Explore system builds</a>
      <a class="btn" data-motion-burst data-motion-shake-related="cover-title" href={resume}>Resume</a>
      <a class="btn" data-motion-burst data-motion-shake-related="cover-title" href={`mailto:${links.email}`}>Email</a>
    </div>
  </div>
  <KineticMarquee />
</section>

<style>
  .cover {
    position: relative;
    min-height: min(760px, calc(100svh - var(--nav-height)));
    overflow: hidden;
    border-bottom: var(--rule);
    background: var(--yellow);
  }

  .cover__photo {
    position: absolute;
    inset: 0 0 0 auto;
    width: 68%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
    filter: grayscale(1) contrast(1.15);
  }

  .cover__content {
    position: relative;
    z-index: 2;
    width: min(100% - 2rem, var(--max-width));
    margin-inline: auto;
    padding-block: clamp(5rem, 12vw, 9rem) 3rem;
  }

  .cover h1 {
    max-width: 7ch;
    margin-block: 1rem 1.25rem;
    font-size: clamp(4.5rem, 13vw, 11rem);
  }

  .cover__content > p:not(.chapter__label) {
    max-width: 35ch;
    padding: 0.75rem;
    border: var(--rule);
    background: var(--ink);
    color: var(--yellow);
    font-weight: 800;
  }

  .cover__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .cover__issue {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 900;
  }

  @media (max-width: 639px) {
    .cover {
      min-height: 680px;
    }

    .cover__photo {
      inset: 0;
      width: 100%;
      opacity: 0.55;
    }

    .cover__content {
      padding-top: 5rem;
    }

    .cover h1 {
      font-size: clamp(3.25rem, 18vw, 7rem);
    }
  }
</style>
