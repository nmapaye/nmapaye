---
import { education } from '../data/site';
---

<section id="education" class="section">
  <div class="container">
    <h2 class="section__title">Education</h2>
    <div class="edu">
      {
        education.map((item) => (
          <article class="card edu__item">
            <div class="edu__head">
              <h3 class="edu__school">{item.school}</h3>
              <span class="edu__period muted">{item.period}</span>
            </div>
            <p class="edu__degree">{item.degree}</p>
            {item.location && <p class="muted edu__loc">{item.location}</p>}
            {item.details && (
              <ul class="edu__details">
                {item.details.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .edu {
    display: grid;
    gap: var(--sp-6);
  }

  .edu__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
  }

  .edu__school {
    font-size: var(--fs-lg);
  }

  .edu__period {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    white-space: nowrap;
  }

  .edu__degree {
    margin-top: var(--sp-2);
    font-weight: 600;
  }

  .edu__loc {
    font-size: var(--fs-sm);
    margin-top: var(--sp-1);
  }

  .edu__details {
    margin-top: var(--sp-3);
    display: grid;
    gap: var(--sp-1);
    font-size: var(--fs-sm);
  }
</style>
