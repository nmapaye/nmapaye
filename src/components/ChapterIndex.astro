---
import GlitchText from './effects/GlitchText.astro';

const chapters = [
  { number: '01', label: 'Work', href: '#work' },
  { number: '02', label: 'Experience', href: '#experience' },
  { number: '03', label: 'Notes', href: '#notes' },
  { number: '04', label: 'Contact', href: '#contact' },
];
---

<nav class="chapter-index" aria-label="Homepage chapters">
  {chapters.map((chapter) => (
    <a href={chapter.href}>
      <span>{chapter.number} /</span>
      <div class="glitch-text" data-motion-shuffle data-motion-shuffle-label={chapter.label}>
        <strong>{chapter.label}</strong>
        <GlitchText text={chapter.label} />
      </div>
    </a>
  ))}
</nav>

<style>
  .chapter-index {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: var(--rule);
    background: var(--green);
  }

  .chapter-index a {
    min-height: 7rem;
    padding: 1rem;
    display: grid;
    align-content: space-between;
    border-right: var(--rule);
    color: var(--ink);
    text-transform: uppercase;
  }

  .chapter-index a:last-child {
    border-right: 0;
  }

  .chapter-index span {
    font: 900 0.7rem/1 var(--font-mono);
  }

  .chapter-index .glitch-text {
    font: 900 clamp(1.2rem, 3vw, 2.4rem)/0.9 var(--font-display);
  }

  @media (max-width: 959px) {
    .chapter-index {
      grid-template-columns: repeat(2, 1fr);
    }

    .chapter-index a:nth-child(2) {
      border-right: 0;
    }

    .chapter-index a:nth-child(-n + 2) {
      border-bottom: var(--rule);
    }
  }
</style>
