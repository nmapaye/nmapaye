---
import { projects } from '../data/site';
import ProjectCard from './ProjectCard.astro';
import CardStack from './effects/CardStack.astro';
import InfiniteProjectGrid from './effects/InfiniteProjectGrid.astro';
import GlitchText from './effects/GlitchText.astro';
const featured = projects.find((project) => project.featured);
const secondary = projects.filter((project) => !project.featured);
---

<section id="work" class="chapter work" data-motion-showcase aria-labelledby="work-title">
  <header class="work__header">
    <p class="chapter__label">01 / Work</p>
    <h2 id="work-title" class="display" data-motion-shake>Selected work</h2>
  </header>

  <InfiniteProjectGrid />

  {featured && (
    <article class="work-feature" data-motion-card={featured.index}>
      <div class="work-feature__copy">
        <CardStack project={featured} />
        <p class="chapter__label">Featured / {featured.index}</p>
        <div class="glitch-text" data-motion-shuffle data-motion-shuffle-label={featured.name}>
          <h3 class="display">{featured.name}</h3>
          <GlitchText text={featured.name} />
        </div>
        <p class="work-feature__tagline">{featured.tagline}</p>
        <p>{featured.description}</p>
        <dl class="project-focus">
          <div><dt>Problem</dt><dd>{featured.focus.problem}</dd></div>
          <div><dt>System design</dt><dd>{featured.focus.systemDesign}</dd></div>
          <div><dt>Evidence</dt><dd>{featured.focus.evidence}</dd></div>
          <div><dt>Outcome</dt><dd>{featured.focus.outcome}</dd></div>
        </dl>
        <ul class="work-feature__stack" aria-label={`${featured.name} technologies`}>
          {featured.stack.map((tech) => <li>{tech}</li>)}
        </ul>
        {featured.links && (
          <div class="work-feature__links">
            {featured.links.map((link) => <a class="btn" data-motion-burst data-motion-shake-related="work-title" href={link.href}>{link.label} ↗</a>)}
          </div>
        )}
      </div>
      <dl class="work-feature__metrics">
        {featured.metrics?.map((metric) => (
          <div>
            <dt>{metric.value}</dt>
            <dd>{metric.label}</dd>
          </div>
        ))}
      </dl>
    </article>
  )}

  <div class="work__grid">
    {secondary.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  .work__header {
    padding: clamp(3rem, 7vw, 6rem) max(1rem, calc((100vw - var(--max-width)) / 2));
    background: var(--ink);
    color: var(--paper);
  }

  .work__header h2 {
    margin-top: 1rem;
    font-size: clamp(4rem, 11vw, 9rem);
  }

  .work-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.55fr);
    border-bottom: var(--rule);
    background: var(--yellow);
  }

  .work-feature__copy {
    padding: clamp(1.5rem, 5vw, 4rem);
    border-right: var(--rule);
  }

  .work-feature__copy .glitch-text {
    margin-block: 1rem;
    font: 900 clamp(4rem, 10vw, 8rem)/0.82 var(--font-display);
    letter-spacing: -0.055em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .work-feature__copy > ul {
    margin-top: 1rem;
  }

  .project-focus {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 1.5rem;
    border: var(--rule);
    background: var(--paper);
  }

  .project-focus > div {
    min-width: 0;
    padding: 1rem;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
  }

  .project-focus > div:nth-child(2n) { border-right: 0; }
  .project-focus > div:nth-last-child(-n + 2) { border-bottom: 0; }

  .project-focus dt {
    font: 900 0.68rem/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-focus dd {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .work-feature__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .work-feature__stack {
    margin-top: 1.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .work-feature__stack li {
    padding: 0.35rem 0.5rem;
    border: 2px solid var(--ink);
    font: 800 0.68rem/1 var(--font-mono);
    text-transform: uppercase;
  }

  .work-feature__links .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .work-feature__metrics {
    display: grid;
    margin: 0;
  }

  .work-feature__metrics div {
    padding: 1.5rem;
    display: grid;
    align-content: end;
    border-bottom: var(--rule);
  }

  .work-feature__metrics dt {
    font: 900 clamp(2rem, 5vw, 4rem)/0.9 var(--font-display);
  }

  .work-feature__metrics dd {
    margin-top: 0.4rem;
    font: 900 0.72rem/1.2 var(--font-mono);
    text-transform: uppercase;
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 959px) {
    .work-feature,
    .work__grid {
      grid-template-columns: 1fr;
    }

    .work-feature__copy {
      border-right: 0;
      border-bottom: var(--rule);
    }

    .project-focus { grid-template-columns: 1fr; }
    .project-focus > div,
    .project-focus > div:nth-child(2n) { border-right: 0; border-bottom: 2px solid var(--ink); }
    .project-focus > div:last-child { border-bottom: 0; }
  }
</style>
