---
import { Image } from 'astro:assets';
import actionPhoto from '../assets/portfolio/experience-table-tennis.png';
import { education, experience, featuredSkills } from '../data/site';
---

<section id="experience" class="chapter experience" aria-labelledby="experience-title">
  <header class="experience__header">
    <p class="chapter__label">02 / Experience</p>
    <h2 id="experience-title" class="display">Systems.<br />Security.<br />Product.</h2>
  </header>

  <div class="experience__body">
    <ol class="experience__timeline">
      {experience.map((item, index) => (
        <li>
          <span class="experience__index">{String(index + 1).padStart(2, '0')}</span>
          <article>
            <header>
              <div>
                <h3>{item.role}</h3>
                <p>{item.org}</p>
              </div>
              <p>{item.period}</p>
            </header>
            {item.location && <p class="experience__location">{item.location}</p>}
            <ul>
              {item.bullets.slice(0, 2).map((bullet) => <li>{bullet}</li>)}
            </ul>
            {item.tools && (
              <p class="experience__tools">{item.tools.slice(0, 5).join(' / ')}</p>
            )}
          </article>
        </li>
      ))}
    </ol>

    <aside class="experience__credentials">
      <Image
        src={actionPhoto}
        alt="Nathaniel Mapaye playing table tennis outdoors"
        widths={[480, 720, 960]}
        sizes="(max-width: 959px) 100vw, 34vw"
        format="webp"
        quality={80}
        loading="lazy"
      />
      <div>
        <p class="chapter__label">Education</p>
        <h3>{education[0].school}</h3>
        <p>{education[0].degree}</p>
        <p>{education[0].period}</p>
      </div>
      <div>
        <p class="chapter__label">Selected tools</p>
        <ul role="list">
          {featuredSkills.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .experience__header {
    padding: clamp(3rem, 8vw, 7rem) max(1rem, calc((100vw - var(--max-width)) / 2));
    background: var(--red);
  }

  .experience__header h2 {
    max-width: 10ch;
    margin-top: 1rem;
    font-size: clamp(4rem, 12vw, 10rem);
  }

  .experience__body {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 0.65fr);
  }

  .experience__timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience__timeline > li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    border-bottom: var(--rule);
  }

  .experience__index {
    padding: 1rem;
    border-right: var(--rule);
    font: 900 0.75rem/1 var(--font-mono);
  }

  .experience__timeline article {
    min-width: 0;
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .experience__timeline article > header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .experience__timeline h3 {
    font: 900 clamp(1.7rem, 4vw, 3.2rem)/0.95 var(--font-display);
    text-transform: uppercase;
  }

  .experience__timeline article > header > p {
    flex: 0 0 auto;
    font: 900 0.72rem/1.3 var(--font-mono);
    text-align: right;
  }

  .experience__location {
    margin-top: 0.65rem;
    font: 700 0.75rem/1.3 var(--font-mono);
  }

  .experience__timeline ul {
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  .experience__tools {
    margin-top: 1rem;
    font: 800 0.72rem/1.5 var(--font-mono);
    text-transform: uppercase;
  }

  .experience__credentials {
    min-width: 0;
    border-left: var(--rule);
    background: var(--green);
  }

  .experience__credentials > * {
    border-bottom: var(--rule);
  }

  .experience__credentials img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .experience__credentials > div {
    padding: 1.25rem;
  }

  .experience__credentials h3 {
    margin-top: 0.8rem;
    font: 900 clamp(1.8rem, 3vw, 3rem)/0.95 var(--font-display);
    text-transform: uppercase;
  }

  .experience__credentials ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 1rem;
    padding-left: 1.1rem;
    font: 800 0.72rem/1.3 var(--font-mono);
    text-transform: uppercase;
  }

  @media (max-width: 959px) {
    .experience__body {
      grid-template-columns: 1fr;
    }

    .experience__credentials {
      border-left: 0;
    }
  }

  @media (max-width: 639px) {
    .experience__header {
      padding: 2.75rem 1rem;
    }

    .experience__header h2 {
      font-size: clamp(2.85rem, 14vw, 4.75rem);
    }

    .experience__timeline > li {
      display: block;
      padding-top: 1rem;
    }

    .experience__index {
      display: inline-block;
      margin-left: 1rem;
      padding: 0.45rem 0.65rem;
      border: var(--rule);
      background: var(--yellow);
    }

    .experience__timeline article {
      width: 100%;
      padding: 1rem 1rem 1.75rem;
    }

    .experience__timeline article > header {
      flex-direction: column;
      gap: 0.4rem;
    }

    .experience__timeline article > header > p {
      text-align: left;
    }

    .experience__timeline ul {
      padding-left: 1.15rem;
      font-size: 1rem;
      line-height: 1.55;
      font-weight: 500;
    }

    .experience__timeline ul li + li {
      margin-top: 0.75rem;
    }

    .experience__tools {
      overflow-wrap: anywhere;
    }

    .experience__credentials img {
      aspect-ratio: 3 / 2;
    }

    .experience__credentials ul {
      gap: 0.5rem;
      padding: 0;
      list-style: none;
    }

    .experience__credentials li {
      padding: 0.4rem 0.55rem;
      border: 2px solid var(--ink);
      background: var(--green);
    }
  }
</style>
