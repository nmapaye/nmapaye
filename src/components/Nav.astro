---
import { links, nav, profile } from '../data/site';

const base = import.meta.env.BASE_URL;
const resume = `${base}/${profile.resume}`.replace(/\/+/g, '/');
---

<header class="masthead">
  <div class="masthead__inner">
    <a class="masthead__brand" href="/">NM / Issue 01</a>

    <nav class="masthead__desktop" aria-label="Primary">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={resume}>Resume</a>
      <a href={`mailto:${links.email}`}>Email</a>
    </nav>

    <details class="masthead__mobile">
      <summary>Menu</summary>
      <nav aria-label="Mobile primary">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={resume}>Resume</a>
        <a href={`mailto:${links.email}`}>Email</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: var(--nav-height);
    border-bottom: var(--rule);
    background: var(--paper);
  }

  .masthead__inner {
    width: min(100% - 2rem, var(--max-width));
    min-height: var(--nav-height);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .masthead__brand,
  .masthead a,
  .masthead summary {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .masthead__desktop {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1vw, 0.75rem);
  }

  .masthead__brand,
  .masthead__desktop a {
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .masthead__mobile {
    display: none;
  }

  @media (max-width: 639px) {
    .masthead__desktop {
      display: none;
    }

    .masthead__mobile {
      display: block;
      position: relative;
    }

    .masthead__mobile summary {
      min-height: 44px;
      display: grid;
      place-items: center;
      cursor: pointer;
    }

    .masthead__mobile nav {
      position: absolute;
      right: 0;
      top: calc(100% + 1rem);
      min-width: 12rem;
      display: grid;
      border: var(--rule);
      background: var(--yellow);
    }

    .masthead__mobile nav a {
      min-height: 44px;
      padding: 0.75rem;
      border-bottom: 2px solid var(--ink);
    }
  }
</style>
