---
import { projects } from '../../data/site';

interface Props { kinetic?: boolean; }
const { kinetic = false } = Astro.props;
const stickerSources = projects.map((project) => (
  `/images/project-posters/${project.name.toLowerCase()}.svg`
));
---

<div
  class="motion-root"
  data-motion-root
  data-motion-kinetic={kinetic ? 'true' : 'false'}
  data-motion-sticker-sources={kinetic ? JSON.stringify(stickerSources) : undefined}
  aria-hidden="true"
>
  <div class="motion-layer motion-layer--blend" data-motion-blobs>
    <span data-motion-blob="lead"></span>
    <span data-motion-blob="trail"></span>
  </div>
  <div class="motion-layer motion-layer--effects">
    <div class="motion-particles" data-motion-particles>
      {Array.from({ length: 8 }, (_, index) => <span data-motion-particle={index}></span>)}
    </div>
    <div class="motion-wipe" data-motion-wipe>
      <span data-motion-wipe-panel="red"></span>
      <span data-motion-wipe-panel="yellow"></span>
      <span data-motion-wipe-panel="green"></span>
    </div>
    {kinetic && (
      <div class="motion-stickers" data-motion-stickers aria-hidden="true">
        <template data-motion-sticker-template>
          <span data-motion-sticker>
            <img data-motion-sticker-image alt="" width="1200" height="1500" decoding="async" />
          </span>
        </template>
      </div>
    )}
  </div>
</div>

<script>
  import { initializeMotion } from '../../scripts/motion/index.mjs';
  const root = document.querySelector('[data-motion-root]');
  if (root) initializeMotion(root);
</script>
